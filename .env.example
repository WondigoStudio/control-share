# Куда ходить за данными (ваш сервер Control) - только чтение
CONTROL_URL=https://your-control.onrender.com
CONTROL_API_TOKEN=тот-же-токен-что-в-App-Hub

# База для хранения ссылок. Можно ту же Neon-базу, что у Control:
# сервис создаёт только свою таблицу share_links.
DATABASE_URL=postgres://user:pass@host/dbname

# Пароль страницы /admin, где вы создаёте и отзываете ссылки (минимум 10 символов)
ADMIN_PASSWORD=придумайте-длинный-пароль

# Необязательно
PORT=3000
# Адрес этого сервиса для красивых ссылок в админке (иначе берётся из запроса)
PUBLIC_BASE_URL=
# Секрет подписи cookie админа (иначе вычисляется из пароля)
SESSION_SECRET=
# false - только для локального запуска по http
COOKIE_SECURE=true
